generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Gimnasio {
  id                String            @id @default(uuid()) @db.Uuid
  nombre            String
  slug              String            @unique
  nombrePropietario String?
  telefono          String?
  qrYapeUrl         String?
  qrPlinUrl         String?
  activo            Boolean           @default(true)
  pruebaHasta       DateTime?         @db.Timestamptz(6)
  suscripcionHasta  DateTime?         @db.Timestamptz(6)
  creadoEn          DateTime          @default(now()) @db.Timestamptz(6)
  actualizadoEn     DateTime          @updatedAt @db.Timestamptz(6)
  asistencias       Asistencia[]
  clientes          Cliente[]
  membresias        Membresia[]
  usuarios          Usuario[]
  invitaciones      Invitacion[]
  pagosSuscripcion  PagoSuscripcion[]

  @@index([activo, suscripcionHasta])
  @@map("gimnasios")
}

model Usuario {
  id            String     @id @db.Uuid
  gimnasioId    String     @db.Uuid
  correo        String
  nombre        String?
  rol           RolUsuario @default(ADMINISTRADOR)
  activo        Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @db.Timestamptz(6)
  actualizadoEn DateTime   @updatedAt @db.Timestamptz(6)
  gimnasio      Gimnasio   @relation(fields: [gimnasioId], references: [id], onDelete: Cascade)

  @@unique([gimnasioId, correo])
  @@index([gimnasioId])
  @@map("usuarios")
}

model Invitacion {
  id         String     @id @default(uuid()) @db.Uuid
  gimnasioId String     @db.Uuid
  correo     String
  rol        RolUsuario @default(ADMINISTRADOR)
  tokenHash  String     @unique @db.VarChar(64)
  expiraEn   DateTime   @db.Timestamptz(6)
  aceptadaEn DateTime?  @db.Timestamptz(6)
  revocadaEn DateTime?  @db.Timestamptz(6)
  creadoEn   DateTime   @default(now()) @db.Timestamptz(6)

  gimnasio Gimnasio @relation(fields: [gimnasioId], references: [id], onDelete: Cascade)

  @@index([gimnasioId, correo])
  @@index([expiraEn])
  @@map("invitaciones")
}

model PagoSuscripcion {
  id               String                @id @default(uuid()) @db.Uuid
  gimnasioId       String                @db.Uuid
  monto            Decimal               @db.Decimal(10, 2)
  moneda           String                @default("PEN") @db.VarChar(3)
  metodoPago       MetodoPagoSuscripcion
  fechaPago        DateTime              @default(now()) @db.Timestamptz(6)
  fechaInicio      DateTime              @db.Timestamptz(6)
  fechaVencimiento DateTime              @db.Timestamptz(6)
  referencia       String?
  observaciones    String?
  creadoEn         DateTime              @default(now()) @db.Timestamptz(6)

  gimnasio Gimnasio @relation(fields: [gimnasioId], references: [id], onDelete: Cascade)

  @@index([gimnasioId, fechaVencimiento])
  @@index([gimnasioId, fechaPago])
  @@map("pagos_suscripcion")
}

model Cliente {
  id            String       @id @default(uuid()) @db.Uuid
  gimnasioId    String       @db.Uuid
  dni           String       @db.VarChar(8)
  nombres       String
  apellidos     String
  telefono      String?
  activo        Boolean      @default(true)
  observaciones String?
  creadoEn      DateTime     @default(now()) @db.Timestamptz(6)
  actualizadoEn DateTime     @updatedAt @db.Timestamptz(6)
  asistencias   Asistencia[]
  gimnasio      Gimnasio     @relation(fields: [gimnasioId], references: [id], onDelete: Cascade)
  membresias    Membresia[]

  @@unique([gimnasioId, dni])
  @@index([gimnasioId, apellidos, nombres])
  @@index([gimnasioId, activo])
  @@map("clientes")
}

model Membresia {
  id               String     @id @default(uuid()) @db.Uuid
  gimnasioId       String     @db.Uuid
  clienteId        String     @db.Uuid
  fechaInicio      DateTime   @db.Date
  fechaVencimiento DateTime   @db.Date
  monto            Decimal    @db.Decimal(10, 2)
  metodoPago       MetodoPago
  observaciones    String?
  creadoEn         DateTime   @default(now()) @db.Timestamptz(6)
  cliente          Cliente    @relation(fields: [clienteId], references: [id])
  gimnasio         Gimnasio   @relation(fields: [gimnasioId], references: [id], onDelete: Cascade)

  @@index([gimnasioId, fechaVencimiento])
  @@index([gimnasioId, clienteId, fechaVencimiento])
  @@map("membresias")
}

model Asistencia {
  id           String           @id @default(uuid()) @db.Uuid
  gimnasioId   String           @db.Uuid
  clienteId    String?          @db.Uuid
  dniIngresado String           @db.VarChar(8)
  estado       EstadoAsistencia
  fechaHora    DateTime         @default(now()) @db.Timestamptz(6)
  cliente      Cliente?         @relation(fields: [clienteId], references: [id])
  gimnasio     Gimnasio         @relation(fields: [gimnasioId], references: [id], onDelete: Cascade)

  @@index([gimnasioId, fechaHora])
  @@index([gimnasioId, estado, fechaHora])
  @@index([gimnasioId, dniIngresado, fechaHora])
  @@map("asistencias")
}

enum RolUsuario {
  ADMINISTRADOR
  PERSONAL
}

enum MetodoPago {
  EFECTIVO
  YAPE
  PLIN
  TRANSFERENCIA
  TARJETA
  OTRO
}

enum EstadoAsistencia {
  REGISTRADA
  VENCIDA
  DNI_NO_ENCONTRADO
}

enum MetodoPagoSuscripcion {
  EFECTIVO
  YAPE
  PLIN
  TRANSFERENCIA
  TARJETA
  OTRO
}
